# DeepSeek SDK is the default model provider.
ALONG_LLM_PROVIDER=deepseek
ALONG_PROXY_URL=http://127.0.0.1:8091/v1/responses
# Display model Deepseek-V4.1-Flash maps through the existing Codex proxy alias.
ALONG_MODEL=deepseek-v4.1-flash
# Used by both the DeepSeek model provider and Search/Fetch.
ALONG_DEEPSEEK_API_KEY=
ALONG_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Must be a DeepSeek model that accepts image input.
ALONG_DEEPSEEK_MODEL=deepseek-flash
# Budget includes reasoning and final JSON; complex plans need enough room.
ALONG_DEEPSEEK_MAX_TOKENS=16384
ALONG_DEEPSEEK_REASONING_EFFORT=low
ALONG_PORT=8766
ALONG_EVENT_WINDOW=10
ALONG_EVENT_FRAMES=10
ALONG_EVENT_OVERLAP_FRAMES=2
ALONG_FRAME_INTERVAL=1
ALONG_MAX_STORAGE_MB=4096
ALONG_RETENTION_DAYS=7
# Cloud ASR; local_whisper must be selected explicitly (no automatic fallback).
ALONG_SPEECH_PROVIDER=siliconflow
ALONG_SILICONFLOW_API_KEY=
ALONG_SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ALONG_SPEECH_TIMEOUT=60
ALONG_WHISPER_MODEL=small
ALONG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Off by default: enable with `along prepare-embeddings`, then set true.
ALONG_SEMANTIC_ENABLED=false

ALONG_MEMORY_ROUNDS=2
ALONG_MEMORY_RESULTS=5
ALONG_CLIP_FRAMES=8
ALONG_CLIP_SECONDS=8
ALONG_MEMORY_CANDIDATES=512
ALONG_AGENT_TIMEOUT=100
ALONG_MEMORY_CATALOG_CHARS=24000

# Default recent-history window; the agent may trace earlier after inspecting recent footage.
ALONG_MEMORY_RECENT_SECONDS=30

# Confirmed task Q&A deadline; task preparation retains the longer agent timeout.
ALONG_TASK_ANSWER_TIMEOUT=12
